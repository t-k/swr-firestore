{
  "name": "@tatsuokaniwa/swr-firestore",
  "version": "3.2.0",
  "description": "React Hooks library for Firestore using SWR's subscription feature.",
  "keywords": [
    "firestore",
    "swr"
  ],
  "homepage": "https://github.com/t-k/swr-firestore#readme",
  "bugs": {
    "url": "https://github.com/t-k/swr-firestore/issues"
  },
  "license": "MIT",
  "author": "t-k (https://github.com/t-k)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-k/swr-firestore.git"
  },
  "files": [
    "dist",
    "README.module.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./subscription": {
      "import": {
        "types": "./dist/subscription.d.ts",
        "default": "./dist/subscription.js"
      },
      "require": {
        "types": "./dist/subscription.d.cts",
        "default": "./dist/subscription.cjs"
      }
    },
    "./aggregate": {
      "import": {
        "types": "./dist/aggregate.d.ts",
        "default": "./dist/aggregate.js"
      },
      "require": {
        "types": "./dist/aggregate.d.cts",
        "default": "./dist/aggregate.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./module": {
      "import": {
        "types": "./dist/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "require": {
        "types": "./dist/module/index.d.cts",
        "default": "./dist/module/index.cjs"
      }
    },
    "./module/query": {
      "import": {
        "types": "./dist/module/query.d.ts",
        "default": "./dist/module/query.js"
      },
      "require": {
        "types": "./dist/module/query.d.cts",
        "default": "./dist/module/query.cjs"
      }
    },
    "./module/subscription": {
      "import": {
        "types": "./dist/module/subscription.d.ts",
        "default": "./dist/module/subscription.js"
      },
      "require": {
        "types": "./dist/module/subscription.d.cts",
        "default": "./dist/module/subscription.cjs"
      }
    },
    "./module/server": {
      "import": {
        "types": "./dist/module/server/index.d.ts",
        "default": "./dist/module/server/index.js"
      },
      "require": {
        "types": "./dist/module/server/index.d.cts",
        "default": "./dist/module/server/index.cjs"
      }
    },
    "./module/aggregate": {
      "import": {
        "types": "./dist/module/aggregate.d.ts",
        "default": "./dist/module/aggregate.js"
      },
      "require": {
        "types": "./dist/module/aggregate.d.cts",
        "default": "./dist/module/aggregate.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc --emitDeclarationOnly --declaration --rootDir src --outDir dist && node scripts/fix-declarations.mjs",
    "emulator": "firebase emulators:start --project swr-firestore-project --only firestore",
    "test": "vitest",
    "test:ci": "firebase emulators:exec --only auth,firestore,storage 'vitest run --coverage'",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "package:check": "pnpm run build && attw --pack --profile node16 && publint",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@faker-js/faker": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "firebase": ">=9.17.0",
    "firebase-admin": ">=11.5.0",
    "jsdom": "^29.0.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.57.0",
    "publint": "^0.3.21",
    "react": "^19",
    "react-dom": "^19",
    "swr": "^2.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "firebase": ">=9.11.0",
    "firebase-admin": ">=11.0.0",
    "react": ">=18",
    "swr": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.19.0"
}
